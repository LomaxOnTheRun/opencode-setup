{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-haiku-4-5",
  "tools": {
    "read": true,
    "glob": true,
    "list": true,
    "grep": true,
    "*": false
  },
  "permission": {
    "bash": {
      "ls *": "allow",
      "grep *": "allow",
      "*": "deny"
    }
  }
}
